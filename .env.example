# Set in your shell; the scripts do not load this file automatically.
OPENROUTER_API_KEY=
# Optional: use cached Hugging Face weights only after downloading them.
OATTACK_LOCAL_FILES_ONLY=0
# Optional: local mirror containing <org>/<model> directories.
# OATTACK_HF_MIRROR_ROOT=/path/to/models
# Optional: separate Python runtimes for specialized local evaluators.
# OATTACK_PYTHON_VLM_NEW=/path/to/minicpm-env/bin/python
# OATTACK_PYTHON_VLM_DEEPSEEK2=/path/to/deepseek-env/bin/python
# OATTACK_PYTHON_VLM_MOLMO=/path/to/molmo-env/bin/python
